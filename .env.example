# The application reads these directly from the process environment.
# This file is a reference for shell exports and future Compose configuration.

SINKHOLE_DNS_LISTEN=:1053
SINKHOLE_HTTP_LISTEN=:8080
SINKHOLE_DATA_DIR=./data
SINKHOLE_UPSTREAMS=1.1.1.1:53,1.0.0.1:53
SINKHOLE_DNS_TIMEOUT=5s
SINKHOLE_DNS_MAX_INFLIGHT=256
SINKHOLE_QUERY_RETENTION=720h
SINKHOLE_BLOCKLIST_REFRESH=24h
SINKHOLE_LOG_LEVEL=info
SINKHOLE_LOG_FORMAT=text

# Docker Compose host port mappings.
SINKHOLE_DNS_PORT=53
SINKHOLE_WEB_PORT=8080

# Image built by `make docker-build` or `docker compose build`.
SINKHOLE_IMAGE=network-wide-dns-sinkhole:local
